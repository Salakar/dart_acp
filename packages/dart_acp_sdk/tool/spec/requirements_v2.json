      "requirements": [
        {
          "id": "v2.migration.scope",
          "sections": [
            "Scope: stable v2 and draft surfaces",
            "Version negotiation"
          ],
          "summary": "v2 remains explicitly negotiated and feature-gated; its unstable schema is an additional opt-in overlay, never implied by protocolVersion 2.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.inventory",
          "sections": [
            "At a glance",
            "Method changes",
            "`session/update` variant changes"
          ],
          "summary": "The v1 and v2 method/update inventories remain physically isolated, including renamed auth, removed load/modes/client execution APIs, and new upsert/state/terminal variants.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.initialization",
          "sections": [
            "Initialization",
            "Role-agnostic `info` and `capabilities`",
            "Support markers are objects, not booleans",
            "Capability reorganization"
          ],
          "summary": "v2 initialization requires shared info/capabilities names, presence-based object markers, nested session groups, and baseline methods when session support is advertised.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.auth",
          "sections": ["Authentication", "Auth methods"],
          "summary": "authenticate/logout become auth/login and auth/logout, methodId/type are explicit, and non-empty authMethods advertises both operations.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.prompt",
          "sections": [
            "The new prompt lifecycle",
            "v1: the response is the turn",
            "v2: the response is an acknowledgment",
            "Session states",
            "Cancellation",
            "Why this matters beyond bookkeeping"
          ],
          "summary": "The prompt response acknowledges acceptance; running/requires_action/idle updates own progress and completion, including cancelled idle after pending updates.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.messages",
          "sections": [
            "Messages and message IDs",
            "Message IDs are required",
            "Whole-message upserts"
          ],
          "summary": "Agent-owned message IDs are required and whole-message/chunk updates apply replace-clear-append semantics.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.upserts",
          "sections": [
            "Tool calls",
            "One upsert notification",
            "Streaming tool-call content",
            "Agent-owned terminal display",
            "Diff content",
            "Permission requests",
            "Plans"
          ],
          "summary": "Tool calls, terminals, diffs, permissions, and plans use ID-keyed extensible upserts with explicit patch, streaming, safe-display, absolute-path, and fail-closed permission semantics.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.sessions",
          "sections": [
            "Session setup and lifecycle",
            "`session/load` is gone. `session/resume` does both",
            "Consistent lifecycle requests",
            "Baseline methods",
            "Session modes become config options",
            "Client file system and terminal execution removed",
            "MCP server configuration",
            "Content blocks",
            "Slash commands",
            "Consistent ID naming"
          ],
          "summary": "resume absorbs load replay, list/resume/close are baseline, modes become config, client execution moves to MCP, and all v2 names/content shapes follow the new consistent inventory.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.compatibility",
          "sections": ["Extensibility and forward compatibility", "Transports"],
          "summary": "Unknown future values are preserved, known malformed tags are rejected, underscore values are custom, and v2 additionally follows JSON-RPC batch rules.",
          "rationaleId": "versioned-spec-wins"
        },
        {
          "id": "v2.migration.checklists",
          "sections": [
            "Migration checklist: Agents",
            "Migration checklist: Clients",
            "Migration checklist: SDKs",
            "Supporting v1 and v2 side by side"
          ],
          "summary": "Agents, clients, and SDKs keep v1 working, negotiate each connection, gate drafts, preserve unknowns, and test both protocol generations independently.",
          "rationaleId": "versioned-spec-wins"
        }
      ]
