    "proposal-context": "Proposal or decision history only; current protocol pages define behavior and the pinned official schemas win for wire shape.",
    "informational-overlap": "Informational overview; its runtime concepts are covered by the traced versioned protocol pages.",
    "ecosystem-catalog": "Ecosystem or implementation listing; it imposes no dart_acp_sdk runtime behavior.",
    "project-governance": "Project governance material; it imposes no SDK runtime or wire requirement.",
    "project-information": "Project resource material; it imposes no SDK runtime or wire requirement.",
    "website-api": "Website API description, not the ACP peer-to-peer JSON-RPC protocol implemented by this package."
