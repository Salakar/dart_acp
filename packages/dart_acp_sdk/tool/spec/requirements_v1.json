          "id": "v1.elicitation.user-controls",
          "sections": ["User interaction requirements"],
          "summary": "Clients identify the requesting agent, protect privacy, present context, allow review, and provide decline/cancel controls.",
          "rationaleId": "caller-policy"
        },
        {
          "id": "v1.elicitation.gating",
          "sections": ["Checking support", "Creating an elicitation"],
          "summary": "Each mode requires an explicit non-null capability; elicitations bind to the receiving connection and verified user, not an untrusted session identifier.",
          "rationaleId": "runtime-enforced"
        },
        {
          "id": "v1.elicitation.form-security",
          "sections": ["Form mode"],
          "summary": "Both sides validate form schemas and values; form mode never collects access credentials or transaction secrets and cannot replace an unavailable safe URL flow.",
          "rationaleId": "caller-policy"
        },
        {
          "id": "v1.elicitation.url-security",
          "sections": ["URL mode", "Responses", "URL completion", "URL security"],
          "summary": "URL mode keeps tokens off ACP, requires explicit informed navigation in an isolated context, scopes opaque completion IDs to the connection/user, and handles decline/cancel/failure without assuming success.",
          "rationaleId": "caller-policy"
        }
      ]
